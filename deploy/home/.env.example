# community 레포 홈서버 이전 파일럿 — deploy/home/compose.yml 용 환경변수.
# 실제 값을 채운 .env 파일은 절대 커밋하지 말 것(.gitignore 확인) — chmod 600 권장.
# 아래 값은 전부 더미/예시이며 실제 시크릿이 아니다.

# --- DB (호스트에 이미 떠 있는 db-mysql 컨테이너, community 스키마 복원됨) ---
DB_USERNAME=community_app
DB_PASSWORD=change-me

# --- Redis (호스트에 이미 떠 있는 db-redis 컨테이너) ---
SPRING_DATA_REDIS_DATABASE=0
SPRING_DATA_REDIS_PASSWORD=change-me

# --- 관리자 API 시크릿 키 ---
ADMIN_SECRET_KEY=change-me

# --- AWS S3 (이미지 저장) ---
AWS_ACCESS_KEY=change-me
AWS_SECRET_KEY=change-me
S3_FOLDER=home

# --- 메일 발송(Gmail SMTP, 앱 비밀번호) ---
MAIL_USERNAME=change-me@gmail.com
MAIL_PASSWORD=change-me

# --- Discord 알림 웹훅 ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/change-me

# --- JWT (32바이트 이상 권장) ---
JWT_SECRET_KEY=change-me-to-a-long-random-base64-value-32bytes-min

# --- CORS(콤마 구분 오리진 목록) ---
CORS_ALLOWED_ORIGINS=https://community-home.example.com
